# ═══════════════════════════════════════════════════
# TFT Agent Set 17 — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# ── App ──────────────────────────────────────────────
APP_NAME=TFT Agent Set 17
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────
# Development: SQLite (file-based, zero config)
DB_PATH=data/tft.db
# Production: Postgres (uncomment and configure)
POSTGRES_URL=postgresql://tft:tft_password@postgres:5432/tft_agent

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# ── Riot API ─────────────────────────────────────────
# Get your key at https://developer.riotgames.com/
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── SMS (verification codes) ────────────────────────
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ── Milvus (vector database) ────────────────────────
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ── Neo4j (graph database) ──────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tft_neo4j_password

# ── vLLM (inference engine) ─────────────────────────
VLLM_HOST=vllm
VLLM_PORT=8001
VLLM_MODEL=Qwen/Qwen2.5-14B-Instruct-AWQ

# ── Agent / LLM (W3) ────────────────────────────────
# OpenAI-compatible endpoint (vLLM, Ollama, or OpenAI).
# Leave OPENAI_API_BASE empty to use the rule-based planner fallback.
OPENAI_API_BASE=
OPENAI_API_KEY=sk-placeholder
LLM_MODEL=qwen2.5-14b-awq
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
AGENT_MAX_ITERATIONS=3
CHECKPOINT_DB=data/checkpoints.db

# ── Monitoring ───────────────────────────────────────
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# ── Observability ───────────────────────────────────
LANGCHAIN_API_KEY=ls-xxxxxxxx
LANGCHAIN_PROJECT=tft-agent-set17
LANGCHAIN_TRACING_V2=true
MLFLOW_TRACKING_URI=http://localhost:5000
